# === Telegram Bot ===
# Get token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=xxxxxxxxxx:yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy
# Your personal chat ID (run get_chat_id.py once to fetch)
TELEGRAM_ALLOWED_CHAT_ID=123456789

# === Zoom Server-to-Server OAuth ===
# Create an S2S OAuth app at https://marketplace.zoom.us/develop/create
# Required scopes: meeting:write:admin, meeting:read:admin, user:read:admin
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# === Google Calendar ===
# Phase 1 uses Claude Code MCP connector (already authenticated).
# Phase 2 standalone bot will add:
#   GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, GOOGLE_REFRESH_TOKEN
GOOGLE_CALENDAR_ACCOUNT=your.email@domain.com

# === Template Calendar ===
CONTACT_PHONE=+84xxxxxxxxx
CONTACT_NAME=Your Name
CONTACT_TITLE=Your Title

# === Test ===
TEST_EMAIL=your.test@email.com

# === Turso libSQL (optional — bỏ trống → dùng SQLite local) ===
# Đăng ký turso.tech → Create Database → copy URL + token
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# === Phase 3 — Multi-user (group mode) ===
TELEGRAM_OWNER_USER_ID=
TELEGRAM_GROUP_CHAT_ID=
GOOGLE_CALENDAR_PERSONAL_ID=primary
GOOGLE_CALENDAR_TEAM_ID=

# USERS_CONFIG_JSON — JSON array các user trong group team. Compact 1 dòng:
# [{"user_id":111,"display_name":"Name","email":"a@x.com","role":"admin","team":"Team","calendar_color":"6","title_prefix":"[Brand] ","signature":"...","telegram_username":""},{...}]
# role: "admin" | "member"
# calendar_color: 1-11 (Google Calendar eventColorId, 6=Tangerine, 9=Blueberry, 10=Basil)
# Empty/unset → group mode reject mọi user (chỉ personal mode chat 1-1 hoạt động)
USERS_CONFIG_JSON=
